# Used by examples/docker-compose.yml. Copy to ".env" next to the compose file (git-ignored here).
# Values below are placeholders; none of them are real.

GPU_PCI=0000:01:00.0
GPU_AUDIO_PCI=0000:01:00.1
VFIO_GROUP=17                 # must equal the group printed by scripts/status.sh

# Address of the host interface that Sunshine/RDP/SSH/noVNC ports are published on.
# Use a LAN address, NOT 0.0.0.0.
LAN_BIND_IP=192.0.2.10

WINDOWS_USERNAME=winuser
WINDOWS_PASSWORD=change-me-before-first-boot
WINDOWS_KEYBOARD=en-US
WINDOWS_RAM=16G
WINDOWS_CPU_CORES=12
WINDOWS_DISK=512G
