# homelab-gpu-workstation configuration.
# Copy to config/gpu.env (git-ignored) and edit. Override the location with HGW_CONFIG=/path/to/file.
# This file is sourced by bash: plain KEY="value" lines only.

# --- GPU identity (find yours with: lspci -nnk | grep -A3 -i nvidia) -----------
GPU_PCI="0000:01:00.0"          # GPU function (VGA/3D controller)
GPU_AUDIO_PCI="0000:01:00.1"    # HDMI/DP audio function of the same card

# IOMMU group. "auto" reads it from sysfs and verifies it. If you pin a number and it
# differs from reality, the scripts refuse to run.
VFIO_GROUP="auto"

# Optional safety net: vendor:device IDs the scripts must see (lowercase, from lspci -nn).
# Leave empty to skip. Example: EXPECT_GPU_ID="10de:2705"
EXPECT_GPU_ID=""
EXPECT_AUDIO_ID=""

# Drivers the devices are expected to use while owned by Linux.
GPU_LINUX_DRIVER="nvidia"
AUDIO_LINUX_DRIVER="snd_hda_intel"

# --- Windows VM (Docker Compose, dockur/windows) --------------------------------
WINDOWS_CONTAINER="windows"                  # container_name in the compose file
WINDOWS_SERVICE="windows"                    # service name in the compose file
WINDOWS_COMPOSE_DIR="/path/to/windows-vm"    # directory containing the compose file
WINDOWS_COMPOSE_FILE="docker-compose.yml"

# --- NVIDIA userspace -----------------------------------------------------------
PERSISTENCED_UNIT="nvidia-persistenced"      # systemd unit holding /dev/nvidia* open (set "" if unused)
# CDI spec regeneration after the GPU returns to Linux (NVIDIA Container Toolkit):
#   auto = regenerate only if nvidia-ctk exists AND the spec file below already exists
#   on   = always regenerate (fails if nvidia-ctk is missing)
#   off  = never touch CDI
CDI_MODE="auto"
CDI_SPEC_PATH="/etc/cdi/nvidia.yaml"

# --- Timeouts (seconds) ---------------------------------------------------------
UNBIND_TIMEOUT=30        # one sysfs unbind may not block longer than this
STOP_TIMEOUT=180         # graceful Windows shutdown (match stop_grace_period in compose)
VFIO_RELEASE_WAIT=30     # wait for /dev/vfio/<group> to be released after QEMU exits
NVIDIA_RETURN_WAIT=30    # wait for NVIDIA drivers to reclaim the GPU

# --- Advanced -------------------------------------------------------------------
# LOCK_FILE="/run/hgw-gpu-transition.lock"
# ALLOW_SHARED_GROUP=0   # 1 = accept an IOMMU group with extra devices (dangerous, see docs)
