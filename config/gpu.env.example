# OPTIONAL advanced overrides. In the simple case you do NOT need this file.
#
# What the scripts discover on their own:
#   - the GPU        : the single NVIDIA display-class PCI device (several -> error, you must choose)
#   - its audio      : the single NVIDIA audio function in the same slot (several -> error)
#   - IOMMU group    : read from sysfs and verified (must contain only the two functions)
#   - the container  : the single dockurr/windows container (several -> error)
#   - compose file   : read from the container's Docker labels once it exists
#   - NVIDIA/CDI     : CDI is refreshed only if nvidia-ctk and an existing CDI spec are present
#
# The ONE thing that cannot be discovered is the compose file, and only until the container has
# been created once (the first start creates it from this file). Everything else below is a rarely
# needed override. Uncomment only what you need.
#
# Location: config/gpu.env in the clone (git-ignored), or any path via HGW_CONFIG=/path/to/file.
# The file is sourced by bash AS ROOT: plain KEY="value" lines, root-owned, not writable by others.

# --- Needed only to create the Windows container for the first time ---------------
#WINDOWS_COMPOSE="/path/to/windows-vm/docker-compose.yml"

# --- Override auto-discovery (multi-GPU hosts, non-NVIDIA GPUs: the latter is untested) ----
#GPU_PCI="0000:01:00.0"
#GPU_AUDIO_PCI="0000:01:00.1"
#WINDOWS_CONTAINER="windows"        # several dockurr/windows containers
#WINDOWS_SERVICE="windows"          # compose file with several services
#VFIO_GROUP="17"                    # optional safety pin: the scripts refuse if the real group differs

# --- Driver names expected while Linux owns the GPU (defaults shown) ----------------
#GPU_LINUX_DRIVER="nvidia"
#AUDIO_LINUX_DRIVER="snd_hda_intel"

# --- NVIDIA userspace ------------------------------------------------------------
#PERSISTENCED_UNIT="nvidia-persistenced"   # "" if you do not run it
#CDI_MODE="auto"                           # auto | off | on
#CDI_SPEC_PATH="/etc/cdi/nvidia.yaml"

# --- Timeouts in seconds (defaults shown) -------------------------------------------
#UNBIND_TIMEOUT=30
#STOP_TIMEOUT=180
#VFIO_RELEASE_WAIT=30
#NVIDIA_RETURN_WAIT=30

# --- Dangerous ----------------------------------------------------------------------
#ALLOW_SHARED_GROUP=0    # 1 = accept an IOMMU group with extra devices. Read docs/iommu-and-vfio.md first
